---
// Una página por esfera, con los artículos cuya categoría coincide con la esfera
import Base from '../../layouts/Base.astro';
import Tarjeta from '../../components/Tarjeta.astro';
import { getCollection } from 'astro:content';
import { esferas, esferaDe } from '../../data/esferas';

export function getStaticPaths() {
  return esferas.map((esfera) => ({ params: { slug: esfera.slug }, props: { esfera } }));
}
const { esfera } = Astro.props;
const posts = (await getCollection('blog', (p) => !p.data.borrador && esferaDe(p.data.categoria)?.slug === esfera.slug))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());
const otras = esferas.filter((e) => e.slug !== esfera.slug);
---
<Base title={`${esfera.nombre} | Álvaro Inostroza`} description={esfera.frase}>
  <main class="pagina" style={`--tono:${esfera.tono}`}>
    <header class="cabecera">
      <span class="orbe" aria-hidden="true"></span>
      <div>
        <p class="rotulo">Esfera</p>
        <h1>{esfera.nombre}</h1>
        <p class="frase">{esfera.frase}</p>
      </div>
    </header>

    {posts.length > 0
      ? <div class="grilla">{posts.map((post) => <Tarjeta post={post} />)}</div>
      : <p class="vacio">Pronto habrá textos en esta esfera.</p>}

    <nav class="otras" aria-label="Otras esferas">
      <span>Otras esferas</span>
      {otras.map((e) => <a href={`/esferas/${e.slug}/`} style={`--tono:${e.tono}`}>{e.nombre}</a>)}
    </nav>
  </main>
</Base>
<style>
  .pagina { max-width: 1140px; margin: 0 auto; padding: 2rem 1.5rem; }
  .cabecera { display: flex; align-items: center; gap: 1.8rem; margin: 1rem 0 3rem; }
  .orbe {
    flex: none; width: 92px; aspect-ratio: 1; border-radius: 50%;
    background:
      radial-gradient(ellipse 48% 34% at 38% 24%, rgba(255,255,255,.55), transparent 75%),
      radial-gradient(circle at 46% 42%, color-mix(in srgb, var(--tono) 45%, #15173f) 0%, #0a0b26 70%, #040516 100%);
    box-shadow: 0 0 30px 4px color-mix(in srgb, var(--tono) 55%, transparent), inset 0 -10px 22px rgba(0,0,0,.55);
    animation: flotar 6s ease-in-out infinite;
  }
  .rotulo { margin: 0; font-size: .75rem; font-weight: 600; letter-spacing: .25em; text-transform: uppercase; color: var(--tono); }
  h1 { margin: .2rem 0 .4rem; font-size: clamp(2rem, 5vw, 3rem); text-transform: uppercase; letter-spacing: .05em; line-height: 1.1; }
  .frase { margin: 0; max-width: 620px; font-family: Georgia, serif; font-size: 1.15rem; color: #c2cde0; font-style: italic; }
  .grilla { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 1.5rem; }
  .vacio { color: var(--suave); font-family: Georgia, serif; font-size: 1.1rem; padding: 2rem 0; }
  .otras { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; margin-top: 4rem; padding-top: 2rem; border-top: 1px solid rgba(140,170,230,.16); }
  .otras span { color: var(--suave); font-size: .8rem; letter-spacing: .15em; text-transform: uppercase; margin-right: .5rem; }
  .otras a { color: var(--tinta); text-decoration: none; font-size: .85rem; padding: .35rem .9rem; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--tono) 50%, transparent); transition: background .3s; }
  .otras a:hover { background: color-mix(in srgb, var(--tono) 20%, transparent); }
  @keyframes flotar { 50% { transform: translateY(-6px); } }
  @media (max-width: 520px) { .cabecera { flex-direction: column; align-items: flex-start; } }
  @media (prefers-reduced-motion: reduce) { .orbe { animation: none; } }
</style>
