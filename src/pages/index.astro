---
import Base from '../layouts/Base.astro';
import RedEsferas from '../components/RedEsferas.astro';
import Tarjeta from '../components/Tarjeta.astro';
import { getCollection } from 'astro:content';

// Los 6 textos más recientes (los "próximamente" van primero)
const posts = (await getCollection('blog', (p) => !p.data.borrador))
  .sort((a, b) => Number(b.data.proximamente) - Number(a.data.proximamente) || b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, 6);

const destacados = [
  { titulo: 'Ensayo sobre IA y Sociedad', sub: 'Tecnología, poder y prospectiva', href: '/blog/', icono: '<path d="M12 2l8 4.5v9L12 22l-8-6.5v-9z"/><path d="M12 2v20M4 6.5l16 9M20 6.5l-16 9"/>' },
  { titulo: 'Proyecto Música Algorítmica', sub: 'Donde los datos suenan', href: '/blog/', icono: '<circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4M5 5l2.8 2.8M16.2 16.2L19 19M5 19l2.8-2.8M16.2 7.8L19 5"/>' },
  { titulo: 'Libro: El Sentido de la Complejidad', sub: 'Próximamente', href: '/blog/', icono: '<path d="M4 4h10a4 4 0 0 1 4 4v12H8a4 4 0 0 1-4-4z"/><path d="M8 4v16"/>' },
  { titulo: 'Contacto', sub: 'alvaroinostroza.cl', href: '#contacto', icono: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>' },
];
---
<Base title="Álvaro Inostroza | Arquitecto de Sentido en Sistemas Complejos">
  <main class="portada">
    <div class="titulares">
      <h1>Arquitecto de Sentido en Sistemas Complejos</h1>
      <p>Una mente. Múltiples dimensiones. Infinitas conexiones.</p>
    </div>

    <section class="heroe">
      <figure class="retrato">
        <img src="/alvaro.png" alt="Álvaro Inostroza" width="517" height="604" />
      </figure>
      <RedEsferas />
    </section>
  </main>

  <nav class="destacados" aria-label="Destacados">
    {destacados.map((d) => (
      <a href={d.href}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={d.icono} />
        <span><strong>{d.titulo}</strong><small>{d.sub}</small></span>
      </a>
    ))}
  </nav>
  <a class="bajar" href="#sobre-mi" aria-label="Bajar">↓</a>

  <div class="columna">
    <section id="sobre-mi" class="bloque bio">
      <p class="lema"><em>Analizo problemas complejos y los convierto en ideas claras y soluciones creativas.</em></p>
      <p>Ingeniero y magíster en Data Science, con más de veinticinco años liderando procesos estratégicos en servicios financieros, retail, educación superior y gestión pública. Escribo sobre instituciones, cambio social y prospectiva, enseño ingeniería de software y hago música.</p>
      <p>Fundé <a href="#">Data Vinci</a>, donde la evidencia y el modelamiento se ponen al servicio de decisiones estratégicas en el sector público y privado.</p>
    </section>

    <section class="bloque libro">
      <h2 class="rotulo">Próximo libro</h2>
      <p class="titulo-libro"><em>El Sentido de la Complejidad</em></p>
      <p>Una descripción de una línea sobre el libro. <a href="#">Saber más →</a></p>
    </section>

    <section class="bloque">
      <h2 class="rotulo">En otros medios</h2>
      <p class="medios"><em>Medio uno</em> · <em>Medio dos</em> · <em>Medio tres</em> · <em>Medio cuatro</em></p>
    </section>

  </div>

  <section class="articulos">
    <h2 class="rotulo">Últimos artículos</h2>
    <div class="grilla-tarjetas">
      {posts.map((post) => <Tarjeta post={post} />)}
    </div>
    <p class="todos"><a href="/blog/">Ver todos los artículos →</a></p>
  </section>

  <section id="contacto" class="contacto">
    <h2>Conversemos</h2>
    <p>Escríbeme para charlas, asesorías o proyectos.</p>
    <a class="boton" href="mailto:contacto@alvaroinostroza.cl">contacto@alvaroinostroza.cl</a>
  </section>
</Base>

<style>
  .columna { max-width: 760px; margin: 0 auto; padding: 0 1.5rem; }
  .bloque { padding: 3rem 0 0; }
  .rotulo { margin: 0 0 .8rem; font-size: .78rem; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--cian); }
  .bio p { font-family: Georgia, serif; font-size: 1.12rem; color: #d4dcea; }
  .bio .lema { font-size: clamp(1.3rem, 2.6vw, 1.65rem); color: var(--tinta); line-height: 1.4; }
  .titulo-libro { margin: 0; font-family: Georgia, serif; font-size: 1.6rem; color: var(--tinta); }
  .libro p, .medios { font-family: Georgia, serif; color: #c2cde0; }
  .articulos { max-width: 1140px; margin: 0 auto; padding: 4rem 1.5rem 0; }
  .grilla-tarjetas { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 1.5rem; }
  .todos { margin-top: 2rem; text-align: center; }
  .todos a { color: var(--azul); text-decoration: none; letter-spacing: .04em; }
  .portada { max-width: 1200px; margin: 0 auto; padding: 1rem 1.5rem 0; }
  .titulares { text-align: center; margin: 1rem 0 0; }
  h1 {
    margin: 0; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; line-height: 1.15;
    font-size: clamp(1.3rem, 3.1vw, 2.4rem);
    background: linear-gradient(180deg, #ffffff 30%, #b9c9e6); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .titulares p { margin: .5rem 0 0; color: var(--suave); text-transform: uppercase; letter-spacing: .18em; font-size: clamp(.7rem, 1.4vw, .95rem); }
  .heroe { display: grid; grid-template-columns: 1fr 1.25fr; align-items: center; gap: 2rem; margin-top: 1rem; }
  .retrato { margin: 0; display: flex; justify-content: center; align-self: center; }
  .retrato img {
    width: min(100%, 400px); height: auto; display: block;
    -webkit-mask-image: linear-gradient(to bottom, #000 80%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 80%, transparent 100%);
    animation: aparecer 1.2s ease both;
  }
  .destacados {
    max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid rgba(140, 170, 230, .2); border-bottom: 1px solid rgba(140, 170, 230, .2);
    background: rgba(5, 13, 28, .6); backdrop-filter: blur(6px);
  }
  .destacados a {
    display: flex; gap: .8rem; align-items: center; justify-content: center; padding: 1.1rem 1rem;
    color: var(--tinta); text-decoration: none; transition: background .3s;
  }
  .destacados a:hover { background: rgba(110, 160, 255, .08); }
  .destacados svg { width: 26px; height: 26px; color: var(--suave); flex: none; }
  .destacados strong { display: block; font-size: .85rem; font-weight: 600; }
  .destacados small { display: block; color: var(--suave); font-size: .72rem; }
  .bajar { display: block; width: max-content; margin: 1rem auto; color: var(--suave); text-decoration: none; font-size: 1.4rem; animation: flotar 2.4s ease-in-out infinite; }
  .contacto { text-align: center; padding: 6rem 1.5rem 2rem; }
  .contacto h2 { text-transform: uppercase; letter-spacing: .1em; }
  .contacto p { color: var(--suave); }
  .boton { display: inline-block; margin-top: 1rem; padding: .8rem 1.6rem; border: 1px solid var(--azul); border-radius: 999px; color: var(--tinta); text-decoration: none; box-shadow: 0 0 20px rgba(110, 160, 255, .25); }
  .boton:hover { background: rgba(110, 160, 255, .12); }
  @keyframes flotar { 50% { transform: translateY(6px); } }
  @keyframes aparecer { from { opacity: 0; transform: translateY(12px); } }
  @media (max-width: 860px) {
    .heroe { grid-template-columns: 1fr; }
    .retrato img { width: min(70%, 320px); }
    .destacados { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 861px) {
    .retrato { transform: translateY(-40px); }
  }
  @media (max-width: 520px) { .destacados { grid-template-columns: 1fr; } .destacados a { justify-content: flex-start; } }
  @media (prefers-reduced-motion: reduce) { .bajar, .retrato img { animation: none; } }
</style>
